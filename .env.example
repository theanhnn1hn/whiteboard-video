# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# .env đã nằm trong .gitignore, KHÔNG commit key thật.

# ===================================================
# Chọn engine giọng đọc (Text-to-Speech)
# ===================================================
# - cit        : CIT Voice Studio (offline, miễn phí, chạy trên máy) — MẶC ĐỊNH
# - elevenlabs : ElevenLabs (online, trả phí theo ký tự, giọng tự nhiên nhất)
# - edge       : Edge TTS (online, miễn phí)
# - vbee       : Vbee (online, trả phí theo ký tự)
# Mỗi engine có một nhóm cấu hình riêng bên dưới; chỉ nhóm của engine đang chọn được dùng.
# Tham số dòng lệnh --voice / --speed ghi đè các giá trị này.
TTS_PROVIDER=cit

# ===================================================
# CIT Voice Studio (TTS_PROVIDER=cit)
# Mở ứng dụng CIT Voice Studio trước khi tạo giọng.
# Tài liệu API: <CIT_BASE_URL>/cit-voice-studio.md
# ===================================================
CIT_BASE_URL=http://127.0.0.1:8001
# Chỉ cần khi gọi từ máy khác trong LAN (Cài đặt → Cho máy khác truy cập API)
CIT_API_KEY=
# Tên giọng đúng như GET /voices, có dấu, vd Hải Đăng, Trúc Ly, Mai Anh, Thiện Minh.
# Để trống = Hải Đăng (hoặc giọng mặc định của mô hình nếu mô hình không có Hải Đăng).
CIT_VOICE=Hải Đăng
# Tốc độ: 1.0 = bình thường ( trong khoảng 0.75 - 1.5)
CIT_SPEED=1.0

# ===================================================
# ElevenLabs (TTS_PROVIDER=elevenlabs) — https://elevenlabs.io
# Tạo key: Developers → API Keys; cấp quyền Text to Speech và Voices: Read.
# Xem giọng / model: .venv/bin/python scripts/tts_narration.py --list-voices --provider elevenlabs
#                    .venv/bin/python scripts/tts_narration.py --list-models --provider elevenlabs
# Ước tính số ký tự bị tính phí trước khi chạy: thêm --dry-run
# ===================================================
ELEVENLABS_API_KEY=
# voice_id (20 ký tự) hoặc tên giọng trong "My Voices" của tài khoản
ELEVENLABS_VOICE=
# eleven_v3: tự nhiên nhất, có tiếng Việt. eleven_flash_v2_5: rẻ hơn ~một nửa, cũng có tiếng Việt.
# (eleven_multilingual_v2 KHÔNG có tiếng Việt.)
ELEVENLABS_MODEL=eleven_v3
# Mã ngôn ngữ ISO 639-1 gửi kèm để model đọc đúng tiếng Việt; để trống = model tự nhận
ELEVENLABS_LANGUAGE=vi
# Tốc độ: 1.0 = bình thường (0.5 - 2.0), chỉnh sau khi tạo, giữ nguyên cao độ
ELEVENLABS_SPEED=1.0
# Tuỳ chọn (để trống = theo cài đặt của giọng). Với eleven_v3, STABILITY chỉ nhận 0.0 / 0.5 / 1.0
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEAKER_BOOST=
# Số nguyên để kết quả ổn định hơn giữa các lần tạo (không đảm bảo giống hệt)
ELEVENLABS_SEED=
# 1 = gửi kèm câu trước/sau để ngữ điệu liền mạch (mặc định); 0 = tắt
ELEVENLABS_CONTEXT=1
# Chỉ đổi khi dùng máy chủ theo vùng, vd https://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=

# ===================================================
# Edge TTS (TTS_PROVIDER=edge)
# ===================================================
# vi-VN-NamMinhNeural (nam) hoặc vi-VN-HoaiMyNeural (nữ)
EDGE_VOICE=vi-VN-NamMinhNeural
# Tốc độ: 1.0 = bình thường, 1.1 = nhanh hơn 10% (khoảng 0.5 - 2.0)
EDGE_SPEED=1.05

# ===================================================
# Vbee TTS API (TTS_PROVIDER=vbee) — đăng ký tại https://vbee.vn
# ===================================================
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Dán nguyên mã giọng (voice_code) copy từ giao diện Vbee
VBEE_VOICE=n_hanoi_male_protrainer_education_vc
# Tốc độ: 1.0 = bình thường (khoảng 0.1 - 1.9)
VBEE_SPEED=1.1
